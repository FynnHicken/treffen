# =========================================================================
# Multi-Stage Build for Treffen All-In-One (Fly.io)
# =========================================================================

# Stage 1: Build Skribbl (Go)
FROM golang:1.25-alpine AS skribbl-builder
WORKDIR /app
COPY games/skribbl/go.mod games/skribbl/go.sum ./
RUN go mod download
COPY games/skribbl ./
RUN CGO_ENABLED=0 go build -trimpath -ldflags "-w -s" -tags timetzdata -o /scribblers ./cmd/scribblers

# Stage 2: Build Guess The Price Client (Vite + React)
FROM node:22-alpine AS monopoly-client-builder
WORKDIR /repo
COPY packages/boardgame-kit packages/boardgame-kit
COPY games/monopoly/client/package.json games/monopoly/client/package-lock.json games/monopoly/client/
RUN cd games/monopoly/client && npm ci --no-audit --no-fund
COPY games/monopoly/client games/monopoly/client
RUN cd games/monopoly/client && npm run build

FROM node:22-alpine AS mensch-client-builder
WORKDIR /repo
COPY packages/boardgame-kit packages/boardgame-kit
COPY packages/tabletop packages/tabletop
COPY games/mensch/client/package.json games/mensch/client/package-lock.json games/mensch/client/
RUN cd games/mensch/client && npm ci --no-audit --no-fund
COPY games/mensch/client games/mensch/client
RUN cd games/mensch/client && npm run build

FROM node:22-alpine AS schach-client-builder
WORKDIR /repo
COPY packages/boardgame-kit packages/boardgame-kit
COPY packages/tabletop packages/tabletop
COPY games/schach/client/package.json games/schach/client/package-lock.json games/schach/client/
RUN cd games/schach/client && npm ci --no-audit --no-fund
COPY games/schach/client games/schach/client
RUN cd games/schach/client && npm run build

FROM node:22-alpine AS maumau-client-builder
WORKDIR /repo
COPY packages/boardgame-kit packages/boardgame-kit
COPY packages/tabletop packages/tabletop
COPY games/maumau/client/package.json games/maumau/client/package-lock.json games/maumau/client/
RUN cd games/maumau/client && npm ci --no-audit --no-fund
COPY games/maumau/client games/maumau/client
RUN cd games/maumau/client && npm run build

# Stockfish 19 (offizielles GitHub-Release, Prüfsumme fest in fetch_stockfish.py; GPL-3.0, Lizenz liegt bei)
FROM python:3.11-slim AS stockfish
COPY games/schach/tools/fetch_stockfish.py /tmp/
RUN python /tmp/fetch_stockfish.py /opt/stockfish

FROM node:22-bookworm-slim AS gtp-client-builder
WORKDIR /app
COPY games/guess-the-price/apps/client/package*.json ./
RUN npm ci --no-audit --no-fund
COPY games/guess-the-price/apps/client ./
ENV VITE_BASE_PATH=/price-guess/
RUN npm run build

# Stage 3: Final Runtime Image (Debian/Ubuntu slim with Node.js, Python, Nginx)
FROM node:22-bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive

# Install Nginx, Python3, pip, curl, openssl and certificates
RUN apt-get update && apt-get install -y --no-install-recommends \
    nginx \
    python3 \
    python3-pip \
    python3-venv \
    ca-certificates \
    curl \
    openssl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# 1. Party Server
WORKDIR /app/party-server
COPY party-server/package*.json ./
RUN npm install --production
COPY party-server ./

# 2. UNO
WORKDIR /app/uno
COPY games/uno/package*.json ./
COPY games/uno/build ./build
COPY games/uno/client ./client

# 3. Skribbl
WORKDIR /app/skribbl
COPY --from=skribbl-builder /scribblers ./scribblers

# 4. Monopoly
WORKDIR /app/monopoly
COPY games/monopoly/requirements.txt ./
RUN pip install --no-cache-dir --break-system-packages -r requirements.txt
COPY games/monopoly/server ./server
COPY games/monopoly/static ./static
COPY --from=monopoly-client-builder /repo/games/monopoly/static/dist ./static/dist

# 4b. Mensch ärgere dich nicht (Spieltisch-Server + Regeln, gleiche Pfade wie im Repo)
WORKDIR /app/mensch
COPY packages/tabletop-server/requirements.txt ./packages/tabletop-server/
RUN pip install --no-cache-dir --break-system-packages -r packages/tabletop-server/requirements.txt
COPY packages/tabletop-server ./packages/tabletop-server
COPY games/mensch/server ./games/mensch/server
COPY --from=mensch-client-builder /repo/games/mensch/static ./games/mensch/static

# 4c. Schach (gleicher Spieltisch-Server, eigene Regeln)
WORKDIR /app/schach
COPY packages/tabletop-server ./packages/tabletop-server
COPY games/schach/server ./games/schach/server
COPY --from=schach-client-builder /repo/games/schach/static ./games/schach/static
COPY --from=stockfish /opt/stockfish /opt/stockfish

# 4d. Mau-Mau (gleicher Spieltisch-Server, Karten)
WORKDIR /app/maumau
COPY packages/tabletop-server ./packages/tabletop-server
COPY games/maumau/server ./games/maumau/server
COPY --from=maumau-client-builder /repo/games/maumau/static ./games/maumau/static

# 5. Codenames
WORKDIR /app/codenames
COPY games/codenames/requirements.txt ./
RUN pip install --no-cache-dir --break-system-packages gunicorn eventlet -r requirements.txt
COPY games/codenames ./
RUN python3 tools/words_to_image.py

# 6. Guess The Price Backend (Node.js + Prisma + SQLite)
WORKDIR /app/gtp-server
COPY games/guess-the-price/apps/server/package*.json ./
RUN npm ci --no-audit --no-fund
COPY games/guess-the-price/apps/server ./
RUN npx prisma generate
RUN npm run build
ENV DATABASE_URL="file:/app/gtp-server/prisma/dev.db"
RUN npx prisma db push --skip-generate
RUN npm run seed

# 7. Static Assets & Nginx Config
RUN rm -rf /usr/share/nginx/html/*
COPY party-hub /usr/share/nginx/html
COPY --from=gtp-client-builder /app/dist /usr/share/nginx/html/price-guess
COPY fly_nginx.conf /etc/nginx/nginx.conf
COPY fly_entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

EXPOSE 8080
ENV PORT=8080

ENTRYPOINT ["/entrypoint.sh"]
