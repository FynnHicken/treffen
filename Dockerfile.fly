# Stage 1: Build Skribbl (Go)
FROM docker.io/golang:1.25.5 AS skribbl-builder
WORKDIR /app
COPY games/skribbl/go.mod games/skribbl/go.sum ./
RUN go mod download
COPY games/skribbl/ /app/
ENV CGO_ENABLED=0
RUN go build -trimpath -ldflags "-w -s -X 'github.com/scribble-rs/scribble.rs/internal/version.Version=fly'" -tags timetzdata -o /scribblers ./cmd/scribblers

# Stage 2: Unified Runtime (Python 3.11 + Node 20 + Nginx)
FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    gnupg \
    nginx \
    && curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

# 1. Party-Server
WORKDIR /srv/party-server
COPY party-server/package*.json ./
RUN npm install --production
COPY party-server/ ./

# 2. Monopoly 3D
WORKDIR /srv/monopoly
RUN python3 -m venv /opt/venv-monopoly
COPY games/monopoly/requirements.txt ./
RUN /opt/venv-monopoly/bin/pip install --no-cache-dir -r requirements.txt
COPY games/monopoly/ ./

# 3. UNO
WORKDIR /srv/uno
COPY games/uno/build ./build
COPY games/uno/client ./client
COPY games/uno/package.json ./

# 4. Codenames
WORKDIR /srv/codenames
RUN python3 -m venv /opt/venv-codenames
COPY games/codenames/requirements.txt ./
RUN /opt/venv-codenames/bin/pip install --no-cache-dir --upgrade pip gunicorn eventlet \
    && /opt/venv-codenames/bin/pip install --no-cache-dir -r requirements.txt
COPY games/codenames/codenames ./codenames
COPY games/codenames/tools ./tools
RUN /opt/venv-codenames/bin/python tools/words_to_image.py

# 5. Skribbl
WORKDIR /srv/skribbl
COPY --from=skribbl-builder /scribblers /srv/skribbl/scribblers

# 6. PartyHub Static Frontend & Nginx Reverse Proxy
COPY party-hub/ /usr/share/nginx/html/
COPY fly/nginx.conf /etc/nginx/nginx.conf
COPY fly/start.sh /srv/start.sh
RUN chmod +x /srv/start.sh

EXPOSE 8080
CMD ["/srv/start.sh"]
