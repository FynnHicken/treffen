{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@treffen/boardgame-kit": ["../../../packages/boardgame-kit/src/index.ts"],
      "@treffen/tabletop": ["../../../packages/tabletop/src/index.ts"],
      "three": ["./node_modules/@types/three/index.d.ts"],
      "three/addons/*": ["./node_modules/@types/three/examples/jsm/*"],
      "cannon-es": ["./node_modules/cannon-es/dist/cannon-es.d.ts"]
    }
  },
  "include": ["src", "../../../packages/boardgame-kit/src", "../../../packages/tabletop/src"]
}
